# Copy this file to ".env" and fill in your key. The .env file is git-ignored.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional overrides:
# GEMINI_MODEL=gemini-2.5-flash
# PORT=8787

# ── Guestbook sign-in (optional) ─────────────────────────────────────────────
# Leave these blank to use the built-in "demo" sign-in locally. To enable real
# Google / GitHub sign-in, create OAuth apps and fill these in.
# SESSION_SECRET=change-me-to-a-long-random-string
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#   GitHub OAuth app → Authorization callback URL: http://localhost:8787/api/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#   Google OAuth client → Authorized redirect URI: http://localhost:8787/api/auth/google/callback
# PUBLIC_BASE_URL=http://localhost:3000     # your frontend origin
# API_BASE_URL=http://localhost:8787        # this backend

# ── Book a Call → Google Calendar + Meet ─────────────────────────────────────
# When these are set, "Confirm booking" creates a Google Calendar event with a
# Google Meet link and Google emails the invite (with the Meet link) to the
# guest and to you. Leave them blank to run in "stub" mode (validates + logs,
# no real email) so the flow still works locally.
#
# One-time setup:
#  1. Google Cloud Console → enable the "Google Calendar API".
#  2. Create an OAuth 2.0 Client ID (type: Web application). Add
#     https://developers.google.com/oauthplayground as an authorized redirect URI.
#  3. In the OAuth Playground (gear ▸ "Use your own OAuth credentials"), authorize
#     the scope  https://www.googleapis.com/auth/calendar.events  and exchange the
#     code for a REFRESH token. Paste the three values below.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary                # or a specific calendar id
# BOOKING_HOST_EMAIL=albertovergani267@gmail.com   # optional: also invites you
